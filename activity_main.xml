<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="12dp" android:background="#F4F4F4"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:background="#232323" android:padding="14dp"
        android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="BACCARAT ANALYZER" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="21sp" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/total" android:text="Mãos: 0" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="16sp" android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:text="HISTÓRICO" android:textStyle="bold" android:textSize="18sp"
        android:paddingTop="12dp" android:paddingBottom="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <com.example.baccarat.HistoryView android:id="@+id/history"
        android:background="#FFFFFF" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>

    <TextView android:id="@+id/stats" android:text="JOGADOR: 0 (0.00%)&#10;BANCA: 0 (0.00%)&#10;EMPATE: 0 (0.00%)"
        android:textSize="16sp" android:textStyle="bold" android:padding="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/sequence" android:text="Sequência atual: -"
        android:textSize="15sp" android:textStyle="bold" android:padding="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/player" android:text="JOGADOR" android:backgroundTint="#2364D2"
            android:textColor="#FFFFFF" android:layout_weight="1" android:layout_width="0dp" android:layout_height="55dp"/>
        <Button android:id="@+id/tie" android:text="EMPATE" android:backgroundTint="#BE911E"
            android:textColor="#FFFFFF" android:layout_weight="1" android:layout_width="0dp" android:layout_height="55dp"/>
        <Button android:id="@+id/banker" android:text="BANCA" android:backgroundTint="#C82D2D"
            android:textColor="#FFFFFF" android:layout_weight="1" android:layout_width="0dp" android:layout_height="55dp"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/undo" android:text="DESFAZER" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="52dp"/>
        <Button android:id="@+id/clear" android:text="LIMPAR" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="52dp"/>
    </LinearLayout>
</LinearLayout>
